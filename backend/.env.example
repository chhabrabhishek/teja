DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://dabble:dabble@localhost:5432/dabble

# JWT
JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=60

# Email one-time codes
EMAIL_CODE_PEPPER=dev-pepper-change-me
EMAIL_CODE_TTL_SECONDS=600
# In DEBUG the code is printed to the console instead of emailed.
DEFAULT_FROM_EMAIL=hello@dabble.app

# Sign in with Apple
APPLE_BUNDLE_ID=app.dabble.ios

# Object storage (S3 or Cloudflare R2)
MEDIA_BUCKET=dabble-media
MEDIA_REGION=auto
MEDIA_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
MEDIA_PUBLIC_BASE_URL=https://media.dabble.app
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Apple Dev
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_KEY_PATH=/secure/path/AuthKey_XXXXXXXXXX.p8
APNS_USE_SANDBOX=true

# Optional
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SENTRY_DSN=
