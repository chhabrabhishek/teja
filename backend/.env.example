DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://teja:teja@localhost:5432/teja

# JWT
JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=60

# Email one-time codes
EMAIL_CODE_PEPPER=dev-pepper-change-me
EMAIL_CODE_TTL_SECONDS=600
# In DEBUG the code is printed to the console instead of emailed.
DEFAULT_FROM_EMAIL=hello@teja.app

# Sign in with Apple
APPLE_BUNDLE_ID=app.teja.ios

# Object storage (S3 or Cloudflare R2)
MEDIA_BUCKET=teja-media
MEDIA_REGION=auto
MEDIA_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
MEDIA_PUBLIC_BASE_URL=https://media.teja.app
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SENTRY_DSN=
